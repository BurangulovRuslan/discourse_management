{
  "name": "discourse-atlas-explorer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node ../scripts/layout_explorer.mjs && ng serve --host 127.0.0.1",
    "layout": "node ../scripts/layout_explorer.mjs",
    "check:search": "node ../scripts/check_archive_search.mjs",
    "check:neighborhood": "node ../scripts/check_neighborhood.mjs",
    "build": "node ../scripts/layout_explorer.mjs && ng build && node publish.mjs"
  },
  "dependencies": {
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "minisearch": "7.2.0",
    "rxjs": "~7.8.2",
    "three": "0.180.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.12",
    "@angular/cli": "20.3.12",
    "@angular/compiler-cli": "20.3.34",
    "@types/three": "0.180.0",
    "d3-force-3d": "3.0.6",
    "typescript": "~5.9.3"
  }
}
